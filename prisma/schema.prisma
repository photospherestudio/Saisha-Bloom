datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  clerkId             String?              @unique
  supabaseUserId      String?              @unique
  email               String               @unique
  displayName         String?
  timezone            String?
  deletionRequestedAt DateTime?
  deletionErrorRef    String?
  deletionAttempts    Int                  @default(0)
  createdAt           DateTime             @default(now())
  children            Child[]
  memberships         ChildMember[]
  sentInvites         ChildInvite[]        @relation("InviteSender")
  responses           MilestoneResponse[]  @relation("ResponseAuthor")
  reminderPreferences ReminderPreference[]
  reminderDeliveries  ReminderDelivery[]
  policyAcceptances   PolicyAcceptance[]
  pushSubscriptions   PushSubscription[]
  observationUploads  ObservationUpload[]

}

model Child {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  dob              DateTime
  gender           String?
  gestationalWeeks Int?
  heightCm         Float?
  weightKg         Float?
  guardianAttestedAt          DateTime?
  guardianNoticeVersion       String?
  guardianVerificationMethod  String?
  guardianVerificationRef     String?
  deletionRequestedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  responses        MilestoneResponse[]
  members          ChildMember[]
  invites          ChildInvite[]
  reminderPreferences ReminderPreference[]
  reminderDeliveries  ReminderDelivery[]
  growthMeasurements GrowthMeasurement[]
  observationUploads ObservationUpload[]

  @@index([userId])
}

model Milestone {
  id               String              @id @default(cuid())
  title            String
  domain           String
  ageRangeMinMonths Float
  ageRangeMaxMonths Float
  source           String
  sourceUrl        String
  responses        MilestoneResponse[]
  recommendations  Recommendation[]
  emergenceWindow  MilestoneEmergenceWindow?
  observationUploads ObservationUpload[]
}

model MilestoneResponse {
  id          String    @id @default(cuid())
  childId     String
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String?
  author      User?     @relation("ResponseAuthor", fields: [userId], references: [id], onDelete: SetNull)
  status      String
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  anonymizedAt          DateTime?
  anonymizationBatchId  String?
  retentionExpiresAt    DateTime?
  retainedAt            DateTime?
  media       MilestoneResponseMedia[]

  @@index([childId, milestoneId, createdAt])
  @@index([childId, createdAt])
  @@index([userId, createdAt])
  @@index([anonymizationBatchId])
}

model MilestoneResponseMedia {
  id         String            @id @default(cuid())
  responseId String
  response   MilestoneResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  objectPath String            @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime          @default(now())

  @@index([responseId, createdAt])
}

model ChildMember {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor")
  invitedBy String?
  createdAt DateTime @default(now())

  @@unique([childId, userId])
  @@index([userId, createdAt])
}

model ChildInvite {
  id        String    @id @default(cuid())
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  invitedBy String
  sender    User      @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([childId, email])
  @@index([email, expiresAt])
}

model ReminderPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  emailCheckpointEnabled Boolean @default(false)
  pushCheckpointEnabled Boolean @default(false)
  caregiverActivityEnabled Boolean @default(false)
  emailConsentAt DateTime?
  pushConsentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, childId])
  @@index([enabled, updatedAt])
}

model ReminderDelivery {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkpoint  Int
  channel     String   @default("email")
  status      String   @default("pending")
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, childId, checkpoint, channel])
  @@index([status, createdAt])
  @@index([userId])
  @@index([childId])
}

model PolicyAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  acceptedAt DateTime @default(now())

  @@unique([userId, document, version])
  @@index([userId, acceptedAt])
}

model GrowthMeasurement {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  heightCm   Float?
  weightKg   Float?
  createdAt  DateTime @default(now())

  @@index([childId, measuredAt])
}

model MilestoneEmergenceWindow {
  id         String    @id @default(cuid())
  milestoneId String   @unique
  milestone  Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  minMonths  Float
  maxMonths  Float
  source     String
  sourceUrl  String
  reviewedAt DateTime

}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

model ObservationUpload {
  id          String    @id
  childId     String
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String
  note        String?
  files       Json
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([childId])
  @@index([milestoneId])
  @@index([userId])
  @@index([expiresAt])
}

model Recommendation {
  id               String    @id @default(cuid())
  milestoneId      String
  milestone        Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  triggerStatus    String
  activityText     String
  tipText          String
  illustrationSlug String
}

model Guidance {
  id                 String   @id @default(cuid())
  externalId         String   @unique
  title              String
  summary            String
  domain             String
  ageRangeMinMonths  Int
  ageRangeMaxMonths  Int
  kind               String
  sourceKey          String
  sourceName         String
  sourceUrl          String
  reviewedAt         DateTime

  @@index([ageRangeMinMonths, ageRangeMaxMonths, domain])
  @@index([kind, ageRangeMinMonths, ageRangeMaxMonths])
}

model AuthRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  windowStart DateTime
  attempts    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
