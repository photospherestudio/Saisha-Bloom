datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  clerkId             String?              @unique
  supabaseUserId      String?              @unique
  email               String               @unique
  timezone            String?
  createdAt           DateTime             @default(now())
  children            Child[]
  memberships         ChildMember[]
  sentInvites         ChildInvite[]        @relation("InviteSender")
  responses           MilestoneResponse[]  @relation("ResponseAuthor")
  reminderPreferences ReminderPreference[]
  reminderDeliveries  ReminderDelivery[]
}

model Child {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  dob              DateTime
  gender           String?
  gestationalWeeks Int?
  heightCm         Float?
  weightKg         Float?
  createdAt        DateTime            @default(now())
  responses        MilestoneResponse[]
  members          ChildMember[]
  invites          ChildInvite[]
  reminderPreferences ReminderPreference[]
  reminderDeliveries  ReminderDelivery[]
}

model Milestone {
  id               String              @id @default(cuid())
  title            String
  domain           String
  ageRangeMinMonths Float
  ageRangeMaxMonths Float
  source           String
  sourceUrl        String
  responses        MilestoneResponse[]
  recommendations  Recommendation[]
}

model MilestoneResponse {
  id          String    @id @default(cuid())
  childId     String
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String
  author      User      @relation("ResponseAuthor", fields: [userId], references: [id], onDelete: Restrict)
  status      String
  note        String?
  createdAt   DateTime  @default(now())
  media       MilestoneResponseMedia[]

  @@index([childId, milestoneId, createdAt])
  @@index([childId, createdAt])
  @@index([userId, createdAt])
}

model MilestoneResponseMedia {
  id         String            @id @default(cuid())
  responseId String
  response   MilestoneResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  objectPath String            @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime          @default(now())

  @@index([responseId, createdAt])
}

model ChildMember {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor")
  invitedBy String?
  createdAt DateTime @default(now())

  @@unique([childId, userId])
  @@index([userId, createdAt])
}

model ChildInvite {
  id        String    @id @default(cuid())
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  invitedBy String
  sender    User      @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([childId, email])
  @@index([email, expiresAt])
}

model ReminderPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, childId])
  @@index([enabled, updatedAt])
}

model ReminderDelivery {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkpoint  Int
  status      String   @default("pending")
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, childId, checkpoint])
  @@index([status, createdAt])
}

model Recommendation {
  id               String    @id @default(cuid())
  milestoneId      String
  milestone        Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  triggerStatus    String
  activityText     String
  tipText          String
  illustrationSlug String
}

model Guidance {
  id                 String   @id @default(cuid())
  externalId         String   @unique
  title              String
  summary            String
  domain             String
  ageRangeMinMonths  Int
  ageRangeMaxMonths  Int
  kind               String
  sourceKey          String
  sourceName         String
  sourceUrl          String
  reviewedAt         DateTime

  @@index([ageRangeMinMonths, ageRangeMaxMonths, domain])
  @@index([kind, ageRangeMinMonths, ageRangeMaxMonths])
}
